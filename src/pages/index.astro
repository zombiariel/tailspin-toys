---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import FilterBar from '../components/FilterBar.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
    getAllGames(db),
    getAllCategories(db),
    getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <span
          id="filter-results-count"
          data-testid="filter-results-count"
          class="text-sm text-slate-400"
          aria-live="polite"
          role="status"
        ></span>
      </div>

      <FilterBar categories={categories} publishers={publishers} />

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div id="filter-empty-state" class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
  const publisherSelect = document.getElementById('filter-publisher') as HTMLSelectElement | null;
  const clearButton = document.getElementById('filter-clear') as HTMLButtonElement | null;
  const resultsCount = document.getElementById('filter-results-count');
  const gamesGrid = document.querySelector('[data-testid="games-grid"]') as HTMLElement | null;
  const filterEmptyState = document.getElementById('filter-empty-state');

  function applyFilters(): void {
    const selectedCategory = categorySelect?.value ?? '';
    const selectedPublisher = publisherSelect?.value ?? '';
    const hasActiveFilter = selectedCategory !== '' || selectedPublisher !== '';

    if (clearButton) {
      clearButton.classList.toggle('hidden', !hasActiveFilter);
    }

    const cards = gamesGrid?.querySelectorAll<HTMLElement>('[data-testid="game-card"]') ?? [];
    let visibleCount = 0;

    for (const card of cards) {
      const categoryMatch = selectedCategory === '' || card.dataset.categoryId === selectedCategory;
      const publisherMatch = selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
      const visible = categoryMatch && publisherMatch;
      card.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    }

    if (resultsCount) {
      const total = cards.length;
      resultsCount.textContent = hasActiveFilter
        ? `Showing ${visibleCount} of ${total} games`
        : '';
    }

    if (gamesGrid && filterEmptyState) {
      const noResults = hasActiveFilter && visibleCount === 0;
      gamesGrid.classList.toggle('hidden', noResults);
      filterEmptyState.classList.toggle('hidden', !noResults);
    }
  }

  categorySelect?.addEventListener('change', applyFilters);
  publisherSelect?.addEventListener('change', applyFilters);

  clearButton?.addEventListener('click', () => {
    if (categorySelect) categorySelect.value = '';
    if (publisherSelect) publisherSelect.value = '';
    applyFilters();
  });
</script>
